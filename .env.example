# PostgreSQL 16 + PostGIS 3.4 Configuration (QGIS & ArcGIS Pro Direct Connection)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nusantara_watch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nusantara_watch

# Martin Vector Tile Server (Mapbox Vector Tiles .pbf from PostGIS)
MARTIN_PORT=3001
VITE_MARTIN_URL=http://localhost:3001

# Backend API Gateway
API_PORT=3000
VITE_API_BASE_URL=/api

# Automated Google Sheets -> PostGIS One-Way Sync
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Data Karhutla
GOOGLE_SHEET_POLL_SEC=20
GOOGLE_SHEET_WEBHOOK_SECRET=nusantara-posko-2026
